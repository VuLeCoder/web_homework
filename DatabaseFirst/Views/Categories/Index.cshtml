@model IEnumerable<DatabaseFirst.Models.Category>

@{
    ViewData["Title"] = "Quản lý Thể loại";
}

<h2>Danh sách Thể loại</h2>

<p>
    <a asp-action="Create" class="btn btn-success">+ Thêm mới</a>
</p>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>ID</th>
            <th>Tên Thể loại</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var c in Model)
        {
            <tr>
                <td>@c.CategoryId</td>
                <td>@c.CategoryName</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@c.CategoryId" class="btn btn-warning btn-sm">Sửa</a>
                    <a asp-action="Delete" asp-route-id="@c.CategoryId" class="btn btn-danger btn-sm">Xóa</a>
                </td>
            </tr>
        }
    </tbody>
</table>
