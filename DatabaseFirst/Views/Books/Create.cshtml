@model DatabaseFirst.Models.Book

@{
    ViewData["Title"] = "Thêm sách";
}

<h2>Thêm Sách</h2>

<form asp-action="Create" method="post">
    <div class="mb-3">
        <label>Mã sách</label>
        <input asp-for="BookId" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Tên sách</label>
        <input asp-for="Title" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Tác giả</label>
        <input asp-for="Author" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Giá</label>
        <input asp-for="Price" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Nhà xuất bản</label>
        <select asp-for="PublisherId" class="form-select"
                asp-items="@(new SelectList(ViewBag.Publishers, "PublisherId", "PublisherName"))"></select>
    </div>

    <div class="mb-3">
        <label>Thể loại</label>
        <select asp-for="CategoryId" class="form-select"
                asp-items="@(new SelectList(ViewBag.Categories, "CategoryId", "CategoryName"))"></select>
    </div>

    <button type="submit" class="btn btn-primary">Lưu</button>
    <a asp-action="Index" class="btn btn-secondary">Hủy</a>
</form>
