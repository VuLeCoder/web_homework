@model IEnumerable<DatabaseFirst.Models.Book>

@{
    ViewData["Title"] = "Quản lý Sách";
}

<h2>Danh sách Sách</h2>

<p>
    <a asp-action="Create" class="btn btn-success">+ Thêm mới</a>
</p>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Mã sách</th>
            <th>Tên sách</th>
            <th>Tác giả</th>
            <th>Giá</th>
            <th>Nhà xuất bản</th>
            <th>Thể loại</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var b in Model)
        {
            <tr>
                <td>@b.BookId</td>
                <td>@b.Title</td>
                <td>@b.Author</td>
                <td>@b.Price</td>
                <td>@b.Publisher?.PublisherName</td>
                <td>@b.Category?.CategoryName</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@b.BookId" class="btn btn-warning btn-sm">Sửa</a>
                    <a asp-action="Delete" asp-route-id="@b.BookId" class="btn btn-danger btn-sm">Xóa</a>
                </td>
            </tr>
        }
    </tbody>
</table>
