@model IEnumerable<DatabaseFirst.Models.Publisher>

@{
    ViewData["Title"] = "Quản lý Nhà xuất bản";
}

<h2>Danh sách Nhà xuất bản</h2>

<p>
    <a asp-action="Create" class="btn btn-success">+ Thêm mới</a>
</p>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>ID</th>
            <th>Tên Nhà xuất bản</th>
            <th>Điện thoại</th>
            <th>Địa chỉ</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var p in Model)
        {
            <tr>
                <td>@p.PublisherId</td>
                <td>@p.PublisherName</td>
                <td>@p.Phone</td>
                <td>@p.Address</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@p.PublisherId" class="btn btn-warning btn-sm">Sửa</a>
                    <a asp-action="Delete" asp-route-id="@p.PublisherId" class="btn btn-danger btn-sm">Xóa</a>
                </td>
            </tr>
        }
    </tbody>
</table>
