@model DatabaseFirst.Models.Publisher

@{
    ViewData["Title"] = "Sửa Nhà xuất bản";
}

<h2>Sửa Nhà xuất bản</h2>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="PublisherId" />
    <div class="mb-3">
        <label>Tên Nhà xuất bản</label>
        <input asp-for="PublisherName" class="form-control" />
    </div>
    <div class="mb-3">
        <label>Điện thoại</label>
        <input asp-for="Phone" class="form-control" />
    </div>
    <div class="mb-3">
        <label>Địa chỉ</label>
        <input asp-for="Address" class="form-control" />
    </div>

    <button type="submit" class="btn btn-success">Cập nhật</button>
    <a asp-action="Index" class="btn btn-secondary">Trở lại</a>
</form>
