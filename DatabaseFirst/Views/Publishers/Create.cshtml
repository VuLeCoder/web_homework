@model DatabaseFirst.Models.Publisher

@{
    ViewData["Title"] = "Thêm Nhà xuất bản";
}

<h2>Thêm Nhà xuất bản</h2>

<form asp-action="Create" method="post">
    <div class="mb-3">
        <label>Mã Nhà xuất bản</label>
        <input asp-for="PublisherId" class="form-control" />
    </div>
    <div class="mb-3">
        <label>Tên Nhà xuất bản</label>
        <input asp-for="PublisherName" class="form-control" />
    </div>
    <div class="mb-3">
        <label>Điện thoại</label>
        <input asp-for="Phone" class="form-control" />
    </div>
    <div class="mb-3">
        <label>Địa chỉ</label>
        <input asp-for="Address" class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary">Lưu</button>
    <a asp-action="Index" class="btn btn-secondary">Hủy</a>
</form>
