@model List<Product>

<div class="container mt-3 pb-xxl-5">
    <div class="row">
        <div class="col-md-3">
            @Html.Partial("_CategoryPartial", new List<string>{
            "Áo dài","Áo đông","Túi xách","Đồng hồ","Ví da",
                        "Thắt lưng da","Tủ lạnh","Tivi","Quạt điện","Lò sưởi"
                        })
        </div>

        <div class="col-md-9">

            <div class="card mb-3">
                <div class="card-header bg-primary text-white">
                    Sản phẩm mới nhất
                </div>
                <div class="card-body">
                    <div class="row">
                        @foreach (var p in Model)
                        {
                            <div class="col-md-4 mb-3">
                                <div class="card h-100 small-card">
                                    <img src="@p.Image" class="card-img-top product-img" alt="@p.Name" />
                                    <div class="card-body p-2">
                                        <h6 class="card-title product-name">@p.Name</h6>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>
